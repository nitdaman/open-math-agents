import FormalConjectures.OEIS.«38552»

-- Credit: @desenyon

/-!
# A norm equation for the split-prime cases of Stephan's conjecture 45

For a squarefree radicand `k = 4c - 1`, use the integral basis `1, w` with
`w² = w - c`. When a prime `p` divides `c`, evaluation at 0 and 1 gives
two maps to the residue field. The kernel of the first has norm `p`.
Its class-number power is principal, and evaluation at 1 forces the
coefficient of `w` in a generator to be nonzero modulo `p`. Completing
the square gives the representations in H3 and H4. For fixed class number
and prime these yield a finite search: `x² < 4pⁿ` and `k ≤ 4pⁿ`.

At a ramified prime, the square of the residue ideal is the rational
principal ideal generated by the prime. If the class number is odd, the
residue ideal itself is principal. Its norm bounds the absolute field
discriminant by `4p`. Consequently H1 only needs even class numbers and
the radicands 1 and 2. H2 only needs even class numbers and the radicand 3.
Each comparison asks for any larger squarefree radicand of the same class number.
-/

open NumberField Polynomial OeisA38552
open scoped nonZeroDivisors

namespace OMA.R_OeisA38552_mod_24_of_isA038552_R1

private theorem integral_coordinate {k : ℕ} (hk : Squarefree k) {u : ℚ} {z : ℤ}
    (h : k * (u * u) = (z : ℚ)) : ∃ t : ℤ, (t : ℚ) = u := by
  have hk0 : k ≠ 0 := hk.ne_zero
  have hdiv : Rat.divInt z (k : ℤ) = u * u := by
    rw [Rat.divInt_eq_div, Int.cast_natCast, div_eq_iff (by exact_mod_cast hk0)]
    linarith only [h]
  have hd := Rat.den_dvd z (k : ℤ)
  rw [hdiv, Rat.mul_self_den] at hd
  have hunit := hk u.den (Int.natCast_dvd_natCast.mp hd)
  exact ⟨u.num, (Rat.den_eq_one_iff _).mp (Nat.isUnit_iff.mp hunit)⟩

private theorem integral_coordinates {k c : ℕ} (hs : Squarefree k) (hc : k + 1 = 4 * c)
    (z : QuadraticAlgebra ℚ (-(c : ℚ)) 1) (hz : IsIntegral ℤ z) :
    ∃ a b : ℤ, (a : ℚ) = z.re ∧ (b : ℚ) = z.im := by
  let B := QuadraticAlgebra ℚ (-(c : ℚ)) 1
  have hstar : IsIntegral ℤ (star z) := hz.map (starRingEnd B).toIntAlgHom
  have intVal {q : ℚ} (hq : IsIntegral ℤ (algebraMap ℚ B q)) : ∃ t : ℤ, (t : ℚ) = q :=
    IsIntegrallyClosed.isIntegral_iff.mp
      ((isIntegral_algebraMap_iff (FaithfulSMul.algebraMap_injective ℚ B)).mp hq)
  obtain ⟨t, ht⟩ := intVal (QuadraticAlgebra.algebraMap_trace_eq_add_star z ▸ hz.add hstar)
  obtain ⟨m, hm⟩ := intVal (QuadraticAlgebra.algebraMap_norm_eq_mul_star z ▸ hz.mul hstar)
  rw [QuadraticAlgebra.trace_def, one_mul] at ht
  rw [QuadraticAlgebra.norm_def] at hm
  have hkc : (k : ℚ) + 1 = 4 * (c : ℚ) := by exact_mod_cast hc
  have hdisc : (k : ℚ) * (z.im * z.im) = ((4 * m - t ^ 2 : ℤ) : ℚ) := by
    push_cast
    rw [ht, hm]
    linear_combination z.im ^ 2 * hkc
  obtain ⟨b, hb⟩ := integral_coordinate hs hdisc
  have hZ : (k : ℤ) * b ^ 2 = 4 * m - t ^ 2 := by
    exact_mod_cast (by simpa only [← hb, ← sq] using hdisc :
      (k : ℚ) * (b : ℚ) ^ 2 = ((4 * m - t ^ 2 : ℤ) : ℚ))
  have hkcZ : (k : ℤ) + 1 = 4 * (c : ℤ) := by exact_mod_cast hc
  have heven : Even (t ^ 2 - b ^ 2) := by
    refine ⟨2 * (m - (c : ℤ) * b ^ 2), ?_⟩
    linear_combination hZ - b ^ 2 * hkcZ
  have hpar : Even (t - b) := by
    simpa [Int.even_sub, Int.even_pow] using heven
  obtain ⟨a, ha⟩ := hpar
  refine ⟨a, b, ?_, hb⟩
  have haQ : (t : ℚ) - b = (a : ℚ) + a := by exact_mod_cast ha
  linarith

private theorem even_integral_coordinates {k : ℕ} (hs : Squarefree k) (hk : k % 4 ≠ 3)
    (liftSq : ∀ {u : ℚ} {w : ℤ}, k * (u * u) = (w : ℚ) → ∃ v : ℤ, (v : ℚ) = u)
    (z : QuadraticAlgebra ℚ (-(k : ℚ)) 0) (hz : IsIntegral ℤ z) :
    ∃ a b : ℤ, (a : ℚ) = z.re ∧ (b : ℚ) = z.im := by
  let B := QuadraticAlgebra ℚ (-(k : ℚ)) 0
  have hstar : IsIntegral ℤ (star z) := hz.map (starRingEnd B).toIntAlgHom
  have intVal {q : ℚ} (hq : IsIntegral ℤ (algebraMap ℚ B q)) : ∃ t : ℤ, (t : ℚ) = q :=
    IsIntegrallyClosed.isIntegral_iff.mp
      ((isIntegral_algebraMap_iff (FaithfulSMul.algebraMap_injective ℚ B)).mp hq)
  obtain ⟨t, ht⟩ := intVal (QuadraticAlgebra.algebraMap_trace_eq_add_star z ▸ hz.add hstar)
  obtain ⟨m, hm⟩ := intVal (QuadraticAlgebra.algebraMap_norm_eq_mul_star z ▸ hz.mul hstar)
  simp only [QuadraticAlgebra.trace_def, zero_mul, add_zero] at ht
  rw [QuadraticAlgebra.norm_def] at hm
  obtain ⟨v, hv⟩ := liftSq (u := 2 * z.im) (w := 4*m - t^2) (by
    push_cast
    rw [hm, ht]
    ring)
  have hd : t ^ 2 + (k : ℤ) * v ^ 2 = 4 * m := by
    have h : (t : ℚ)^2 + (k : ℚ)*(v : ℚ)^2 = 4*(m : ℚ) := by
      rw [ht, hm, hv]
      ring
    exact_mod_cast h
  have hnot4 : ¬4 ∣ k := by
    intro h
    have := hs 2 h
    norm_num at this
  have sqMod (v : ℤ) : v ^ 2 % 4 = v % 2 := by
    obtain ⟨j, hj⟩ | h := Int.even_or_odd v
    · subst v
      rw [show (j+j)^2 = 4*j^2 by ring, Int.mul_emod_right, show j+j=2*j by ring,
        Int.mul_emod_right]
    · rw [Int.sq_mod_four_eq_one_of_odd h, Int.odd_iff.mp h]
  have hres : ((t % 2) + ((k : ℤ) % 4) * (v % 2)) % 4 = 0 := by
    calc
      _ = (t ^ 2 + (k : ℤ)*v^2) % 4 := by
        rw [Int.add_emod (t^2), Int.mul_emod (k : ℤ), ← sqMod v, ← sqMod t]
        omega
      _ = 0 := by rw [hd, Int.mul_emod_right]
  have hv2 : v % 2 = 0 := by
    have hk0 : k % 4 ≠ 0 := fun h => hnot4 (Nat.dvd_of_mod_eq_zero h)
    have htCases := Int.emod_two_eq_zero_or_one t
    have hvCases := Int.emod_two_eq_zero_or_one v
    have hkCases : (k : ℤ) % 4 = 1 ∨ (k : ℤ) % 4 = 2 := by omega
    rcases hkCases with h | h <;> rw [h] at hres <;> omega
  have ht2 : t % 2 = 0 := by rw [hv2, mul_zero, add_zero] at hres; omega
  obtain ⟨a, ha⟩ := (Int.dvd_iff_emod_eq_zero.mpr ht2 : (2 : ℤ) ∣ t)
  obtain ⟨b, hb⟩ := (Int.dvd_iff_emod_eq_zero.mpr hv2 : (2 : ℤ) ∣ v)
  have haQ : (t : ℚ) = 2 * (a : ℚ) := by exact_mod_cast ha
  have hbQ : (v : ℚ) = 2 * (b : ℚ) := by exact_mod_cast hb
  exact ⟨a,b, by linarith, by linarith⟩

private theorem integral_order_model {k : ℕ} {a b : ℤ} {aq bq : ℚ}
    (ha : (a : ℚ) = aq) (hb : (b : ℚ) = bq)
    [Fact (Irreducible (X ^ 2 + C (k : ℚ)))]
    [Fact (∀ r : ℚ, r ^ 2 ≠ aq + bq * r)]
    (root : QuadraticAlgebra ℚ aq bq)
    (heval : (X ^ 2 + C (k : ℚ)).eval₂ (algebraMap ℚ _) root = 0)
    (coords : ∀ z : QuadraticAlgebra ℚ aq bq, IsIntegral ℤ z →
      ∃ x y : ℤ, (x : ℚ) = z.re ∧ (y : ℚ) = z.im) :
    Nonempty (𝓞 (AdjoinRoot (X ^ 2 + C (k : ℚ))) ≃ₐ[ℤ] QuadraticAlgebra ℤ a b) := by
  let A := QuadraticAlgebra ℤ a b
  let B := QuadraticAlgebra ℚ aq bq
  let F := AdjoinRoot (X ^ 2 + C (k : ℚ))
  let f : F →ₐ[ℚ] B := AdjoinRoot.liftAlgHom _ (Algebra.ofId ℚ B) root heval
  have dim : Module.finrank ℚ F = Module.finrank ℚ B := by
    have hf : X ^ 2 + C (k : ℚ) ≠ 0 := (Fact.out : Irreducible _).ne_zero
    exact ((AdjoinRoot.powerBasis hf).finrank.trans (AdjoinRoot.powerBasis_dim hf)).trans
      (natDegree_X_pow_add_C.trans (QuadraticAlgebra.finrank_eq_two _ _).symm)
  let e := AlgEquiv.ofBijective f ⟨f.injective,
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := f.toLinearMap) dim).mp f.injective⟩
  let castCoeffs : A →+* B :=
    { toFun := fun w => ⟨(w.re : ℚ), (w.im : ℚ)⟩
      map_zero' := by apply QuadraticAlgebra.ext <;> exact Int.cast_zero
      map_one' := QuadraticAlgebra.ext Int.cast_one Int.cast_zero
      map_add' := by intro u v; apply QuadraticAlgebra.ext <;> simp [A, B]
      map_mul' := by intro u v; apply QuadraticAlgebra.ext <;> simp [A, B, ha, hb] }
  let inc := castCoeffs.toIntAlgHom
  have inc_re (w : A) : (inc w).re = (w.re : ℚ) := rfl
  have inc_im (w : A) : (inc w).im = (w.im : ℚ) := rfl
  let j : A →ₐ[ℤ] 𝓞 B := inc.codRestrict (integralClosure ℤ B)
    (fun a => (Algebra.IsIntegral.isIntegral (R := ℤ) a).map inc)
  have jbij : Function.Bijective j := by
    constructor
    · intro x y h
      have hh : inc x = inc y := congrArg Subtype.val h
      ext
      · exact_mod_cast (by simpa only [inc_re] using congrArg QuadraticAlgebra.re hh : (x.re : ℚ) = y.re)
      · exact_mod_cast (by simpa only [inc_im] using congrArg QuadraticAlgebra.im hh : (x.im : ℚ) = y.im)
    · intro z
      obtain ⟨a, b, ha, hb⟩ := coords z z.property
      refine ⟨⟨a,b⟩, Subtype.ext ?_⟩
      change inc ⟨a,b⟩ = z.val
      exact QuadraticAlgebra.ext (by simpa only [inc_re] using ha) (by simpa only [inc_im] using hb)
  exact ⟨(RingOfIntegers.mapRingEquiv e.toRingEquiv).toIntAlgEquiv.trans
    (AlgEquiv.ofBijective j jbij).symm⟩

private theorem order_model {k c : ℕ} (hc : k + 1 = 4 * c)
    [Fact (Irreducible (X ^ 2 + C (k : ℚ)))]
    (coords : ∀ z : QuadraticAlgebra ℚ (-(c : ℚ)) 1, IsIntegral ℤ z →
      ∃ a b : ℤ, (a : ℚ) = z.re ∧ (b : ℚ) = z.im) :
    Nonempty (𝓞 (AdjoinRoot (X ^ 2 + C (k : ℚ))) ≃ₐ[ℤ]
      QuadraticAlgebra ℤ (-(c : ℤ)) 1) := by
  have hkc : (k : ℚ) + 1 = 4 * (c : ℚ) := by exact_mod_cast hc
  have hn : ∀ r : ℚ, r ^ 2 ≠ -(c : ℚ) + 1 * r := by
    intro r hr
    simp only [one_mul] at hr
    have hcpos : 1 ≤ c := by omega
    have : (1 : ℚ) ≤ c := by exact_mod_cast hcpos
    nlinarith [sq_nonneg (2*r - 1)]
  let _ := Fact.mk hn
  apply integral_order_model (k := k) (aq := -(c : ℚ)) (bq := 1) (by norm_cast) Int.cast_one (root := ⟨-1,2⟩)
  · rw [eval₂_add, eval₂_pow, eval₂_X, eval₂_C, pow_two]
    apply QuadraticAlgebra.ext
    · change (-1 : ℚ) * (-1) + -(c : ℚ) * 2 * 2 + k = 0
      linarith only [hkc]
    · change (-1 : ℚ) * 2 + 2 * (-1) + ((1 : ℤ) : ℚ) * 2 * 2 + 0 = 0
      norm_num
  · exact coords

private theorem even_order_model {k : ℕ} (hk : 0 < k)
    [Fact (Irreducible (X ^ 2 + C (k : ℚ)))]
    (coords : ∀ z : QuadraticAlgebra ℚ (-(k : ℚ)) 0, IsIntegral ℤ z →
      ∃ x y : ℤ, (x : ℚ) = z.re ∧ (y : ℚ) = z.im) :
    Nonempty (𝓞 (AdjoinRoot (X ^ 2 + C (k : ℚ))) ≃ₐ[ℤ] QuadraticAlgebra ℤ (-(k : ℤ)) 0) := by
  have hneg : ∀ r : ℚ, r^2 ≠ -(k : ℚ) + 0*r := by
    intro r hr
    simp only [zero_mul, add_zero] at hr
    have : (0 : ℚ) < k := by exact_mod_cast hk
    nlinarith [sq_nonneg r]
  let _ := Fact.mk hneg
  apply integral_order_model (k := k) (aq := -(k : ℚ)) (bq := 0) (by norm_cast) Int.cast_zero (root := ⟨0,1⟩)
  · rw [eval₂_add, eval₂_pow, eval₂_X, eval₂_C, pow_two]
    apply QuadraticAlgebra.ext
    · change 0 * 0 + -(k : ℚ) * 1 * 1 + k = 0
      ring
    · change (0 : ℚ)*1 + 1*0 + ((0 : ℤ) : ℚ)*1*1 + 0 = 0
      norm_num
  · exact coords

private theorem split_norm_representation {K : Type*} [Field K] [NumberField K]
    {c p n : ℕ} (hc : 0 < c) (hp : p.Prime) (hd : p ∣ c)
    (hn : classNumber K = n)
    (e : 𝓞 K ≃ₐ[ℤ] QuadraticAlgebra ℤ (-(c : ℤ)) 1) :
    ∃ x y : ℤ, ¬ (p : ℤ) ∣ y ∧
      x ^ 2 + (4 * (c : ℤ) - 1) * y ^ 2 = 4 * (p : ℤ) ^ n := by
  classical
  let _ : Fact p.Prime := ⟨hp⟩
  let A := QuadraticAlgebra ℤ (-(c : ℤ)) 1
  have cz : (c : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff c p).mpr hd
  let evalAt (s : ZMod p) (hs : s * s = (-(c : ℤ)) • 1 + (1 : ℤ) • s) :
      A →ₐ[ℤ] ZMod p := QuadraticAlgebra.lift ⟨s, hs⟩
  let f := (evalAt 0 (by simp [zsmul_eq_mul, cz])).toRingHom.comp e.toRingEquiv.toRingHom
  let g := (evalAt 1 (by simp [zsmul_eq_mul, cz])).toRingHom.comp e.toRingEquiv.toRingHom
  have fval (u : 𝓞 K) : f u = ((e u).re : ZMod p) := by
    change (e u).re • (1 : ZMod p) + (e u).im • (0 : ZMod p) = _
    simp [zsmul_eq_mul]
  have gval (u : 𝓞 K) : g u = ((e u).re : ZMod p) + ((e u).im : ZMod p) := by
    change (e u).re • (1 : ZMod p) + (e u).im • (1 : ZMod p) = _
    simp [zsmul_eq_mul]
  let I := RingHom.ker f
  have surj : Function.Surjective f := by
    intro a
    obtain ⟨t, rfl⟩ := ZMod.intCast_surjective a
    exact ⟨(t : 𝓞 K), map_intCast f t⟩
  have hnorm : Ideal.absNorm I = p := by
    change Nat.card (𝓞 K ⧸ RingHom.ker f) = p
    rw [Nat.card_congr (RingHom.quotientKerEquivOfSurjective surj).toEquiv,
      Nat.card_zmod]
  have hI : I ∈ (Ideal (𝓞 K))⁰ := mem_nonZeroDivisors_iff_ne_zero.mpr (by
    intro h
    rw [h, map_zero] at hnorm
    exact hp.ne_zero hnorm.symm)
  have hnpos : 0 < n := hn ▸ classNumber_pos K
  have principal : (I ^ n).IsPrincipal := by
    apply (ClassGroup.mk0_eq_one_iff (pow_mem hI n)).mp
    change ClassGroup.mk0 ((⟨I, hI⟩ : (Ideal (𝓞 K))⁰) ^ n) = 1
    rw [map_pow, ← hn]
    exact pow_card_eq_one
  obtain ⟨z, hz⟩ := principal.principal
  change I ^ n = Ideal.span {z} at hz
  have hzI : z ∈ I ^ n := hz ▸ Ideal.subset_span (Set.mem_singleton z)
  have fzero : f z = 0 := (Ideal.pow_le_self hnpos.ne' hzI : z ∈ I)
  let w := e.symm QuadraticAlgebra.omega
  have fw : w ∈ I := by
    change f w = 0
    simp [fval, w]
  have gw : g w = 1 := by simp [gval, w]
  have hzp : z ∣ w ^ n := by
    apply Ideal.mem_span_singleton.mp
    rw [← hz]
    exact Ideal.pow_mem_pow fw n
  have gnz : g z ≠ 0 := by
    obtain ⟨t, ht⟩ := hzp
    intro h
    have := congrArg g ht
    simp [map_pow, map_mul, gw, h] at this
  have hy : ¬ (p : ℤ) ∣ (e z).im := by
    intro h
    rw [fval] at fzero
    apply gnz
    rw [gval, fzero, (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mpr h, add_zero]
  have hN : (Algebra.norm ℤ (e z)).natAbs = p ^ n := by
    rw [Algebra.norm_eq_of_algEquiv e, ← Ideal.absNorm_span_singleton, ← hz, map_pow, hnorm]
  have hdet : Algebra.norm ℤ (e z) = (e z).norm :=
    QuadraticAlgebra.det_toLinearMap_eq_norm _
  rw [hdet, QuadraticAlgebra.norm_def] at hN
  have hcZ : (1 : ℤ) ≤ c := by exact_mod_cast hc
  have hpositive : 0 ≤ (e z).re * (e z).re + 1 * (e z).re * (e z).im -
      -(c : ℤ) * (e z).im * (e z).im := by
    nlinarith [sq_nonneg (2 * (e z).re + (e z).im),
      mul_nonneg (show 0 ≤ 4 * (c : ℤ) - 1 by omega) (sq_nonneg (e z).im)]
  have heq := congrArg (fun v : ℕ => (v : ℤ)) hN
  simp only [Int.natCast_natAbs, abs_of_nonneg hpositive, Nat.cast_pow] at heq
  exact ⟨2 * (e z).re + (e z).im, (e z).im, hy, by linarith only [heq]⟩

private theorem ramified_bound {K : Type*} [Field K] [NumberField K]
    {d p n : ℕ} {a b : ℤ} (hp : p.Prime) (hd : (d : ℤ) = -(b^2 + 4*a))
    (r : ZMod p) (ha : (a : ZMod p) = -r^2) (hb : (b : ZMod p) = 2*r)
    (hn : classNumber K = n) (hodd : Odd n)
    (e : 𝓞 K ≃ₐ[ℤ] QuadraticAlgebra ℤ a b) : d ≤ 4*p := by
  classical
  let f : 𝓞 K →+* ZMod p := (QuadraticAlgebra.lift (a := a) (b := b)
    ⟨r, by simp only [zsmul_eq_mul, mul_one, ha, hb]; ring⟩).toRingHom.comp e.toRingEquiv.toRingHom
  have fv (z : 𝓞 K) : f z = ((e z).re : ZMod p) + ((e z).im : ZMod p) * r := by
    change (e z).re • (1 : ZMod p) + (e z).im • r = _
    simp [zsmul_eq_mul]
  let I := RingHom.ker f
  have surj : Function.Surjective f := by
    intro x
    obtain ⟨t, rfl⟩ := ZMod.intCast_surjective x
    exact ⟨(t : 𝓞 K), map_intCast f t⟩
  have normI : I.absNorm = p := (Nat.card_congr
    (RingHom.quotientKerEquivOfSurjective surj).toEquiv).trans (Nat.card_zmod p)
  let P := Ideal.span {(p : 𝓞 K)}
  have det (w : QuadraticAlgebra ℤ a b) : Algebra.norm ℤ w = w.norm :=
    QuadraticAlgebra.det_toLinearMap_eq_norm _
  have normP : P.absNorm = p^2 := by
    rw [Ideal.absNorm_span_singleton, ← Algebra.norm_eq_of_algEquiv e, map_natCast, det,
      QuadraticAlgebra.norm_natCast, Int.natAbs_pow, Int.natAbs_natCast]
  have sq_le : I ^ 2 ≤ P := by
    rw [pow_two]
    refine Ideal.mul_le.mpr fun z hz w hw => Ideal.mem_span_singleton.mpr ?_
    change f z = 0 at hz
    change f w = 0 at hw
    rw [fv, add_eq_zero_iff_eq_neg] at hz hw
    have hdiv : (algebraMap ℤ _ (p : ℤ)) ∣ (e (z * w)) := by
      rw [QuadraticAlgebra.algebraMap_dvd_iff, map_mul]
      constructor
      · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
        simp only [QuadraticAlgebra.re_mul, Int.cast_add, Int.cast_mul, hz, hw, ha]
        ring
      · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
        simp only [QuadraticAlgebra.im_mul, Int.cast_add, Int.cast_mul, hz, hw, hb]
        ring
    obtain ⟨v, hv⟩ := hdiv
    refine ⟨e.symm v, e.injective ?_⟩
    rw [map_mul e (p : 𝓞 K), map_natCast, e.apply_symm_apply]
    exact hv
  obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.mpr sq_le
  have eqP : I ^ 2 = P := by
    have hj := congrArg Ideal.absNorm hJ
    rw [map_pow, normI, map_mul, normP] at hj
    have hj1 : J.absNorm = 1 := Nat.eq_of_mul_eq_mul_left (pow_pos hp.pos 2)
      (by simpa using hj.symm : p^2 * J.absNorm = p^2 * 1)
    simpa [Ideal.absNorm_eq_one_iff.mp hj1] using hJ
  have prin2 : (I ^ 2).IsPrincipal := eqP ▸ inferInstanceAs P.IsPrincipal
  have cp : Nat.Coprime 2 (Fintype.card (ClassGroup (𝓞 K))) := by
    change Nat.Coprime 2 (classNumber K)
    rw [hn, Nat.prime_two.coprime_iff_not_dvd]
    exact (Nat.not_even_iff_odd.mpr hodd) ∘ even_iff_two_dvd.mpr
  have prin := Ideal.IsPrincipal.of_isPrincipal_pow_of_coprime cp prin2
  obtain ⟨z, hz⟩ := prin.principal
  change I = Ideal.span {z} at hz
  have hN : (e z).norm.natAbs = p := by
    rw [← det, Algebra.norm_eq_of_algEquiv e, ← Ideal.absNorm_span_singleton, ← hz, normI]
  rw [QuadraticAlgebra.norm_def] at hN
  have hy : (e z).im ≠ 0 := by
    intro h
    apply (Nat.prime_iff.mp hp).not_isSquare
    exact ⟨(e z).re.natAbs, by simpa [h, Int.natAbs_mul] using hN.symm⟩
  have hsq : 1 ≤ (e z).im ^ 2 := by have := sq_pos_of_ne_zero hy; omega
  have hab := congrArg (fun j : ℕ => (j : ℤ)) hN
  rw [Int.natCast_natAbs] at hab
  have hle := le_abs_self ((e z).re * (e z).re + b * (e z).re * (e z).im -
      a * (e z).im * (e z).im)
  have hident : (2 * (e z).re + b * (e z).im)^2 + (d : ℤ)*(e z).im^2 =
      4 * ((e z).re * (e z).re + b * (e z).re * (e z).im - a * (e z).im * (e z).im) := by
    linear_combination (e z).im ^ 2 * hd
  have hbound : (d : ℤ) ≤ 4*(p : ℤ) := calc
    (d : ℤ) ≤ d*(e z).im^2 := le_mul_of_one_le_right (by positivity) hsq
    _ ≤ (2 * (e z).re + b*(e z).im)^2 + d*(e z).im^2 :=
      le_add_of_nonneg_left (sq_nonneg _)
    _ = _ := hident
    _ ≤ 4*(p : ℤ) := mul_le_mul_of_nonneg_left (hle.trans_eq hab) (by decide)
  exact_mod_cast hbound

/-- The local alternatives for a squarefree radicand outside Stephan's residue class.
No maximality hypothesis is needed. -/
theorem candidates_of_bad_residue {n k : ℕ} (hs : Squarefree k) (hclass : HasClassNumber k n)
    (hbad : k % 24 ≠ 19) :
    (k % 4 ≠ 3 ∧ (Even n ∨ k ≤ 2)) ∨
    (k % 8 = 3 ∧ 3 ∣ k ∧ (Even n ∨ k = 3)) ∨
    (k % 8 = 7 ∧ ∃ x y : ℤ, ¬ (2 : ℤ) ∣ y ∧ x^2 + (k : ℤ)*y^2 = 4*(2 : ℤ)^n) ∨
    (k % 8 = 3 ∧ ∃ x y : ℤ, ¬ (3 : ℤ) ∣ y ∧ x^2 + (k : ℤ)*y^2 = 4*(3 : ℤ)^n) := by
  by_cases hk : k % 4 = 3
  · let c := (k + 1) / 4
    have hc : k + 1 = 4 * c := by dsimp [c]; omega
    have hpos : 0 < c := by omega
    obtain ⟨hirr, hnum⟩ := hclass
    let _ := Fact.mk hirr
    obtain ⟨e⟩ := order_model hc (integral_coordinates hs hc)
    have repr (p : ℕ) (hp : p.Prime) (hd : p ∣ c) :
        ∃ x y : ℤ, ¬ (p : ℤ) ∣ y ∧ x ^ 2 + (k : ℤ) * y ^ 2 = 4 * (p : ℤ) ^ n := by
      have hkc : 4 * (c : ℤ) - 1 = k := by omega
      simpa only [hkc] using split_norm_representation hpos hp hd hnum e
    by_cases h7 : k % 8 = 7
    · exact Or.inr (.inr (.inl ⟨h7, repr 2 Nat.prime_two (by omega)⟩))
    · have h3 : k % 8 = 3 := by omega
      by_cases hdiv : 3 ∣ k
      · refine Or.inr (.inl ⟨h3, hdiv, ?_⟩)
        by_cases hev : Even n
        · exact Or.inl hev
        · have hc3 : c % 3 = 1 := by omega
          have cc : (c : ZMod 3) = 1 := by rw [← ZMod.natCast_mod c 3, hc3, Nat.cast_one]
          have small := ramified_bound (a := -(c : ℤ)) (b := 1) (d := k) Nat.prime_three
            (by push_cast; omega) (-1 : ZMod 3)
            (by simp [cc]) (by decide) hnum (Nat.not_even_iff_odd.mp hev) e
          exact Or.inr (by omega)
      · have r8 := Nat.mod_mod_of_dvd k (by decide : 8 ∣ 24)
        have r3 := Nat.mod_mod_of_dvd k (by decide : 3 ∣ 24)
        have hr : k % 24 = 11 := by
          have hlt := Nat.mod_lt k (by decide : 0 < 24)
          interval_cases hres : k % 24 <;> omega
        have hd : 3 ∣ c := ⟨2 * (k / 24) + 1, by omega⟩
        exact Or.inr (.inr (.inr ⟨h3, repr 3 Nat.prime_three hd⟩))
  · refine Or.inl ⟨hk, ?_⟩
    by_cases hev : Even n
    · exact Or.inl hev
    · obtain ⟨hirr, hnum⟩ := hclass
      let _ := Fact.mk hirr
      obtain ⟨e⟩ := even_order_model (Nat.pos_of_ne_zero hs.ne_zero)
        (even_integral_coordinates hs hk (integral_coordinate hs))
      let r := (k : ZMod 2)
      have ha : ((-(k : ℤ) : ℤ) : ZMod 2) = -r^2 := by
        push_cast
        have sq (u : ZMod 2) : u ^ 2 = u := by revert u; decide
        rw [sq]
      have hb : ((0 : ℤ) : ZMod 2) = 2*r := by simp [show (2 : ZMod 2) = 0 by decide]
      have small := ramified_bound (a := -(k : ℤ)) (b := 0) (d := 4*k) Nat.prime_two
        (by push_cast; ring) r ha hb hnum (Nat.not_even_iff_odd.mp hev) e
      exact Or.inr (by omega)

/-- At odd class number every counterexample has an explicit upper bound on its radicand. -/
theorem radicand_le_of_odd_class_number {k n : ℕ} (hs : Squarefree k)
    (hc : HasClassNumber k n) (ho : Odd n) (hbad : k % 24 ≠ 19) : k ≤ 4 * 3^n := by
  have hne := Nat.not_even_iff_odd.mpr ho
  have bound {p : ℕ} {x y : ℤ} (hp : p ≤ 3) (hy : ¬ (p : ℤ) ∣ y)
      (he : x^2 + (k : ℤ)*y^2 = 4*(p : ℤ)^n) : k ≤ 4 * 3^n := by
    have hnz : y ≠ 0 := fun h => hy (h ▸ dvd_zero _)
    have hsq : 1 ≤ y^2 := by have := sq_pos_of_ne_zero hnz; omega
    have hk : (k : ℤ) ≤ 4*(p : ℤ)^n := calc
      (k : ℤ) ≤ k*y^2 := le_mul_of_one_le_right (by positivity) hsq
      _ ≤ x^2 + k*y^2 := le_add_of_nonneg_left (sq_nonneg _)
      _ = _ := he
    exact (show k ≤ 4*p^n by exact_mod_cast hk).trans
      (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hp n))
  have hpos : 0 < 3^n := pow_pos (by decide) _
  rcases candidates_of_bad_residue hs hc hbad with h | h | h | h
  · have := h.2.resolve_left hne
    omega
  · have := h.2.2.resolve_left hne
    omega
  · obtain ⟨_, x, y, hy, he⟩ := h
    exact bound (p := 2) (by decide) hy he
  · obtain ⟨_, x, y, hy, he⟩ := h
    exact bound (p := 3) le_rfl hy he

/-- Candidates with even fundamental discriminant. -/
def H1 : Prop :=
  ∀ k n : ℕ, Squarefree k → HasClassNumber k n → k % 4 ≠ 3 → (Even n ∨ k ≤ 2) →
    ∃ m > k, Squarefree m ∧ HasClassNumber m n

/-- Odd discriminants at which 2 is inert and 3 ramifies. -/
def H2 : Prop :=
  ∀ k n : ℕ, Squarefree k → HasClassNumber k n → k % 8 = 3 → 3 ∣ k → (Even n ∨ k = 3) →
    ∃ m > k, Squarefree m ∧ HasClassNumber m n

/-- Candidates from a primitive-at-2 representation of a power of 2. -/
def H3 : Prop :=
  ∀ (n k : ℕ) (x y : ℤ), Squarefree k → HasClassNumber k n → k % 8 = 7 →
    ¬ (2 : ℤ) ∣ y → x ^ 2 + (k : ℤ) * y ^ 2 = 4 * (2 : ℤ) ^ n →
    ∃ m > k, Squarefree m ∧ HasClassNumber m n

/-- Candidates from a primitive-at-3 representation when 2 is inert. -/
def H4 : Prop :=
  ∀ (n k : ℕ) (x y : ℤ), Squarefree k → HasClassNumber k n → k % 8 = 3 →
    ¬ (3 : ℤ) ∣ y → x ^ 2 + (k : ℤ) * y ^ 2 = 4 * (3 : ℤ) ^ n →
    ∃ m > k, Squarefree m ∧ HasClassNumber m n

theorem main : H1 → H2 → H3 → H4 → type_of% @OeisA38552.mod_24_of_isA038552 := by
  intro hEven hRam hTwo hThree n k h
  obtain ⟨⟨hs, hc⟩, hmax⟩ := h
  by_contra hbad
  suffices ∃ m > k, Squarefree m ∧ HasClassNumber m n by
    obtain ⟨m, hlt, hm⟩ := this
    exact hlt.not_ge (hmax hm hlt.le)
  rcases candidates_of_bad_residue hs hc hbad with h | h | h | h
  · exact hEven k n hs hc h.1 h.2
  · exact hRam k n hs hc h.1 h.2.1 h.2.2
  · obtain ⟨hr, x, y, hy, he⟩ := h
    exact hTwo n k x y hs hc hr hy he
  · obtain ⟨hr, x, y, hy, he⟩ := h
    exact hThree n k x y hs hc hr hy he

end OMA.R_OeisA38552_mod_24_of_isA038552_R1
