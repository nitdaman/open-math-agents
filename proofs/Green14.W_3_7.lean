private def step (i : Nat) := (segments[i/64]!).getD (i%64) 0
private def Block (f : Nat → Bool) (a b : Nat) : Prop :=
  ∀ i, a ≤ i → i < b → f i = true

private theorem block_join {f : Nat → Bool} {a b c : Nat}
    (left : Block f a b) (right : Block f b c) : Block f a c := by
  intro i lo hi
  by_cases h : i < b
  · exact left i lo h
  · exact right i (by omega) hi

private theorem block_of_check {f : Nat → Bool} {start stop : Nat}
    (h : (List.range (stop-start)).all (fun j => f (start+j)) = true) : Block f start stop := by
  intro i lo hi
  have hh := (List.all_eq_true.mp h) (i-start) (List.mem_range.mpr (by omega))
  simpa [Nat.add_sub_of_le lo] using hh

