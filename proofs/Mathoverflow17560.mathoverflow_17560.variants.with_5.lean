namespace OMASixApplication

lemma primeValue (p q : ℕ) [Fact p.Prime] [Fact q.Prime] :
    padicValRat p (q : ℚ) = if p = q then 1 else 0 := by
  rw [padicValRat.of_nat]
  split_ifs with h
  · subst q
    simp
  · simp [padicValNat_primes h]

lemma primeProductVal (a b c : ℤ) (p : ℕ) [Fact p.Prime]
    (h : (2 : ℚ) ^ a * 3 ^ b * 5 ^ c = 1) :
    a * (if p = 2 then 1 else 0) + b * (if p = 3 then 1 else 0) +
      c * (if p = 5 then 1 else 0) = 0 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  have hv := congrArg (padicValRat p) h
  rw [padicValRat.mul (by positivity) (by positivity),
    padicValRat.mul (by positivity) (by positivity)] at hv
  have v2 : padicValRat p 2 = if p = 2 then 1 else 0 := primeValue p 2
  have v3 : padicValRat p 3 = if p = 3 then 1 else 0 := primeValue p 3
  have v5 : padicValRat p 5 = if p = 5 then 1 else 0 := primeValue p 5
  simpa only [padicValRat.zpow, padicValRat.one, v2, v3, v5] using hv

lemma logsIndependent : LinearIndependent ℚ
    ![Complex.log 2, Complex.log 3, Complex.log 5] := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  apply (LinearIndependent.iff_fractionRing ℤ ℚ).mp
  rw [Fintype.linearIndependent_iff]
  intro f hf i
  have he := congrArg Complex.exp hf
  simp [Fin.sum_univ_succ, zsmul_eq_mul, Complex.exp_add, Complex.exp_int_mul,
    Complex.exp_log (by norm_num : (2 : ℂ) ≠ 0),
    Complex.exp_log (by norm_num : (3 : ℂ) ≠ 0),
    Complex.exp_log (by norm_num : (5 : ℂ) ≠ 0)] at he
  have hq : (2 : ℚ) ^ f 0 * 3 ^ f 1 * 5 ^ f 2 = 1 := by
    apply Rat.cast_injective (α := ℂ)
    push_cast
    exact (mul_assoc _ _ _).trans he
  fin_cases i
  · simpa using primeProductVal _ _ _ 2 hq
  · simpa using primeProductVal _ _ _ 3 hq
  · simpa using primeProductVal _ _ _ 5 hq

lemma expOfNatPower {x : ℝ} {p m : ℕ} (hp : 0 < p) (hm : (p : ℝ) ^ x = m) :
    IsAlgebraic ℚ (Complex.exp ((x : ℂ) * Complex.log p)) := by
  have hlog : (Real.log (p : ℝ) : ℂ) = Complex.log p := Complex.natCast_log
  have he : Complex.exp ((x : ℂ) * Complex.log p) = m := by
    rw [← hlog, ← Complex.ofReal_mul, ← Complex.ofReal_exp, mul_comm,
      ← Real.rpow_def_of_pos (by exact_mod_cast hp), hm, Complex.ofReal_natCast]
  rw [he]
  exact isAlgebraic_natCast m

lemma exponentRational
    (six : ∀ (u : Fin 2 → ℂ) (v : Fin 3 → ℂ), LinearIndependent ℚ u →
      LinearIndependent ℚ v → ∃ i j, Transcendental ℚ (Complex.exp (u i * v j)))
    {x : ℝ} (h2 : ∃ m : ℕ, (2 : ℝ) ^ x = m) (h3 : ∃ m : ℕ, (3 : ℝ) ^ x = m)
    (h5 : ∃ m : ℕ, (5 : ℝ) ^ x = m) : ∃ q : ℚ, x = q := by
  by_contra hx
  have hu : LinearIndependent ℚ ![(1 : ℂ), (x : ℂ)] := by
    apply (LinearIndependent.pair_iff' one_ne_zero).mpr
    intro q hq
    apply hx
    refine ⟨q, ?_⟩
    simpa [Algebra.smul_def] using congrArg Complex.re hq.symm
  obtain ⟨i, j, hij⟩ := six _ _ hu logsIndependent
  obtain ⟨m, hm⟩ := h2
  obtain ⟨n, hn⟩ := h3
  obtain ⟨k, hk⟩ := h5
  apply hij
  fin_cases i
  · fin_cases j <;>
      first | simpa using (expOfNatPower (p := 2) (m := 2) (x := 1) (by decide) (by simp))
            | simpa using (expOfNatPower (p := 3) (m := 3) (x := 1) (by decide) (by simp))
            | simpa using (expOfNatPower (p := 5) (m := 5) (x := 1) (by decide) (by simp))
  · fin_cases j
    · exact expOfNatPower (p := 2) (by decide) hm
    · exact expOfNatPower (p := 3) (by decide) hn
    · exact expOfNatPower (p := 5) (by decide) hk

end OMASixApplication

lemma rational_exponent_nat {x : ℝ}
    (hRat : ∃ q : ℚ, x = q) (hx : ∃ m : ℕ, (2 : ℝ) ^ x = m) :
    ∃ n : ℕ, x = n := by
  obtain ⟨q, rfl⟩ := hRat
  obtain ⟨m, hm⟩ := hx
  have hpos : 0 < (m : ℝ) := by
    rw [← hm]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hmpos : 0 < m := by exact_mod_cast hpos
  have hq : 0 ≤ (q : ℝ) := by
    by_contra! h
    have hlt := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num : (1 : ℝ) < 2) h
    rw [hm] at hlt
    have hm1 : m < 1 := by exact_mod_cast hlt
    omega
  have hnum : 0 ≤ q.num := Rat.num_nonneg.mpr (by exact_mod_cast hq)
  have hn : (q.num.toNat : ℝ) = q.num := by exact_mod_cast Int.toNat_of_nonneg hnum
  have hd : (q.den : ℝ) ≠ 0 := by exact_mod_cast q.den_nz
  have hmul : (q : ℝ) * q.den = q.num.toNat := by
    rw [Rat.cast_def, div_mul_cancel₀ _ hd, hn]
  have hpR : (2 : ℝ) ^ q.num.toNat = (m : ℝ) ^ q.den := by
    rw [← Real.rpow_natCast, ← hmul, Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2), hm]
  have hp : (2 : ℕ) ^ q.num.toNat = m ^ q.den := by exact_mod_cast hpR
  have hv := congrArg (fun n : ℕ => n.factorization 2) hp
  change (2 ^ q.num.toNat).factorization 2 = (m ^ q.den).factorization 2 at hv
  rw [Nat.factorization_pow_self Nat.prime_two, Nat.factorization_pow] at hv
  have heq : q.num.toNat = q.den * m.factorization 2 := by
    simpa [Finsupp.smul_apply, nsmul_eq_mul] using hv
  refine ⟨m.factorization 2, ?_⟩
  have heqR : (q.num.toNat : ℝ) = (q.den : ℝ) * (m.factorization 2 : ℝ) := by
    exact_mod_cast heq
  exact (mul_right_cancel₀ hd) (hmul.trans (heqR.trans (mul_comm _ _)))

theorem OMA.solution : type_of% @Mathoverflow17560.mathoverflow_17560.variants.with_5 := by
  intro x h2 h3 h5
  exact rational_exponent_nat (OMASixApplication.exponentRational DiazModulus.six_exponentials h2 h3 h5) h2
